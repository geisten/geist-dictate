#!/bin/sh
# geist-dictate — installed launcher (.deb layout).
#
#   geist-dictate setup    fetch model + tower into ~/.local/share, check mic/uinput
#   geist-dictate toggle   start/stop dictation (bind this to a GNOME shortcut)
#   geist-dictate start|stop|status
#   geist-dictate run      mic -> transcript lines on stdout (no typing)
#
# Dictation types into the focused window via ydotool (uinput — works on
# GNOME Wayland, where the virtual-keyboard protocol is unavailable).
set -e

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/geist-dictate"
MODEL="$DATA/gemma4-e2b-Q4_K_M.gguf"
TOWER="$DATA/audio_tower.safetensors"
MEL="/usr/share/geist-dictate/mel_constants.bin"
UNIT=geist-dictate.service

MODEL_URL="https://huggingface.co/unsloth/gemma-4-E2B-it-GGUF/resolve/main/gemma-4-E2B-it-Q4_K_M.gguf"
MODEL_SHA=9378bc471710229ef165709b62e34bfb62231420ddaf6d729e727305b5b8672d
TOWER_SHA=d6c45a6c276212dc3a793e66dfc588d89c12d1ac92c0e4b85494390ca848cd77

export GEIST_AUDIO_MODEL_PATH="${GEIST_AUDIO_MODEL_PATH:-$TOWER}"
export GEIST_MEL_CONSTANTS_PATH="${GEIST_MEL_CONSTANTS_PATH:-$MEL}"

sha_ok() { [ "$( (sha256sum "$1" 2>/dev/null || shasum -a 256 "$1") | cut -d' ' -f1)" = "$2" ]; }

setup() {
    mkdir -p "$DATA"
    if sha_ok "$MODEL" "$MODEL_SHA"; then
        echo "model ok: $MODEL"
    else
        echo "downloading model (~3.1 GB) ..."
        curl -fL --retry 3 --retry-delay 2 -C - -o "$MODEL" "$MODEL_URL"
        sha_ok "$MODEL" "$MODEL_SHA" || { echo "SHA mismatch: $MODEL" >&2; exit 1; }
    fi
    if sha_ok "$TOWER" "$TOWER_SHA"; then
        echo "audio tower ok: $TOWER"
    else
        echo "downloading audio tower (~590 MB, Range extraction) ..."
        python3 /usr/share/geist-dictate/fetch_audio_tower.py -o "$TOWER" --sha256 "$TOWER_SHA"
    fi
    # Typing path checks — advisory, dictation to stdout works regardless.
    if ! id -nG | tr ' ' '\n' | grep -qx input; then
        echo "NOTE: add yourself to the 'input' group for ydotool typing, then re-login:"
        echo "  sudo usermod -aG input $USER"
    fi
    command -v arecord >/dev/null || echo "NOTE: arecord missing (apt install alsa-utils)"
    echo "setup complete — bind 'geist-dictate toggle' to a keyboard shortcut."
}

pipeline() {
    [ -f "$MODEL" ] || { echo "model missing — run: geist-dictate setup" >&2; exit 1; }
    systemctl --user start ydotoold.service 2>/dev/null || true
    arecord -q -f S16_LE -r 16000 -c 1 -t raw |
        /usr/bin/dictate "$MODEL" "${GEIST_DICTATE_RMS:-300}" |
        while IFS= read -r line; do
            ydotool type -- "$line " || echo "$line"
        done
}

case "$1" in
setup) setup ;;
run)
    shift
    [ -f "$MODEL" ] || { echo "model missing — run: geist-dictate setup" >&2; exit 1; }
    arecord -q -f S16_LE -r 16000 -c 1 -t raw | exec /usr/bin/dictate "$MODEL" "$@"
    ;;
_pipeline) pipeline ;;
start) systemctl --user start "$UNIT" ;;
stop) systemctl --user stop "$UNIT" ;;
status) systemctl --user status "$UNIT" ;;
toggle)
    if systemctl --user is-active --quiet "$UNIT"; then
        systemctl --user stop "$UNIT"
        notify-send -i microphone-sensitivity-muted-symbolic "geist-dictate" "aus" 2>/dev/null || true
    else
        systemctl --user start "$UNIT"
        notify-send -i audio-input-microphone-symbolic "geist-dictate" "hört zu" 2>/dev/null || true
    fi
    ;;
*)
    echo "usage: geist-dictate setup | toggle | start | stop | status | run [rms-threshold]" >&2
    exit 2
    ;;
esac
