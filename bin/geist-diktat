#!/bin/sh
# geist-diktat — thin launcher around the diktat binary.
#
#   geist-diktat setup            fetch model + audio tower (SHA-pinned)
#   geist-diktat run [threshold]  mic → transcript lines on stdout
#
# `run` prints transcripts only; compose the typing yourself until the
# .deb (issue #2) ships the systemd unit + hotkey:
#   geist-diktat run | while IFS= read -r l; do ydotool type -- "$l "; done
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MODEL="$ROOT/geistlib/gguf_artifacts/gemma4-e2b-Q4_K_M.gguf"

export GEIST_AUDIO_MODEL_PATH="${GEIST_AUDIO_MODEL_PATH:-$ROOT/geistlib/audio_bench/audio_tower.safetensors}"
export GEIST_MEL_CONSTANTS_PATH="${GEIST_MEL_CONSTANTS_PATH:-$ROOT/geistlib/audio_test_data/mel_constants.bin}"

case "$1" in
setup)
    make -C "$ROOT" setup
    ;;
run)
    shift
    [ -f "$MODEL" ] || { echo "model missing — run: geist-diktat setup" >&2; exit 1; }
    command -v arecord >/dev/null || { echo "arecord not found (alsa-utils)" >&2; exit 1; }
    arecord -q -f S16_LE -r 16000 -c 1 -t raw | exec "$ROOT/diktat" "$MODEL" "$@"
    ;;
*)
    echo "usage: geist-diktat setup | run [rms-threshold]" >&2
    exit 2
    ;;
esac
